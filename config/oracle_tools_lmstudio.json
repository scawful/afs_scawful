        "generation": {
          "temperature": 0.2,
          "max_tokens": 2048,
          "top_p": 0.85,
          "top_k": 30,
          "repeat_penalty": 1.05
        },
        "load": {
          "context_length": 16384,
          "parallel": 1,
          "gpu_offload": 1.0,
          "flash_attention": true,
          "cpu_threads": 7,
          "ttl": 1800
        }
      },
      "analysis": {
        "description": "Higher temperature for open-ended code analysis and routine explanation.",
        "generation": {
          "temperature": 0.4,
          "max_tokens": 4096,
          "top_p": 0.9,
          "top_k": 40,
