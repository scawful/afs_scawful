{
  "$schema": "../config/registry.schema.json",
  "version": "0.1.0",
  "description": "Oracle Tools LM Studio configuration. Tool-calling model for emulator and MCP workflows.",
  "id": "oracle-tools",
  "name": "Oracle Tools",
  "description_long": "Specialized 7B tool-calling model for 65816 ASM development. Drives yaze-mcp, hyrule-historian, book-of-mudora, and Mesen2 socket CLI. Optimized for structured JSON output and MCP integration.",
